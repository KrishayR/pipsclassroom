{
  "name": "consequencelab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:server\" \"vite --host 127.0.0.1\"",
    "server": "node --experimental-sqlite --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "format": "prettier --write src server scripts tests docs/*.md README.md package.json tsconfig.json vite.config.ts .github/workflows/ci.yml",
    "pilot": "tsx scripts/pilot.ts",
    "seal-seeds": "tsx scripts/seal-seeds.ts",
    "calibrate-gate": "tsx scripts/calibrate-gate.ts",
    "live-batch": "tsx scripts/live-batch.ts",
    "full-game-check": "tsx scripts/full-game-check.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
