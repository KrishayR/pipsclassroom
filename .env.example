# Server-only. Never put these in VITE_* variables.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
# The project uses Contributor mode (Meta may train on prompts and responses). Every study arm must use the same ID.
MODEL_ID=muse-spark-1.3-contributor
PORT=8787
MODEL_TOKEN_BUDGET=100000
# muse-spark-1.3 accepts minimal|low|medium|high|xhigh|max. Hidden reasoning counts against the completion cap.
MODEL_REASONING_EFFORT=low
MODEL_MAX_COMPLETION_TOKENS=4000
# Model-mode lesson check and targeted exercise sizes (each rollout move is a paid decision).
# Leave unset for the defaults: helper on 6 + 2 boards, 1 run; helper off 10 + 4 boards,
# 2 averaged repeats plus a 2-standard-error noise guard (docs/STURDY_GATE.md).
# VERIFY_PRACTICE=6
# VERIFY_REGRESSION=2
# VERIFY_REPEATS=1
VERIFY_MOVES=4
EXERCISE_MOVES=4
# Live batch: total estimated spend cap, and exam size per stage (seeds × moves per
# student). At 25 moves every game hits the cap, so exams cannot show a difference.
BATCH_BUDGET_USD=1
BATCH_EXAM_MOVES=25
BATCH_EXAM_SEEDS=1
# USD per million tokens (Meta pricing page, Oct 2026) for muse-spark-1.3-contributor.
# Standard mode (muse-spark-1.3) is 1.25 / 0.15 / 4.25.
MODEL_PRICE_INPUT_PER_M=0.10
MODEL_PRICE_CACHED_INPUT_PER_M=0.002
MODEL_PRICE_OUTPUT_PER_M=0.20
# Several keys, used in order. Keys are skipped when the provider reports them
# out of credit or invalid. Cumulative spend is tracked without a local cap.
MODEL_API_KEYS=
# Requests per minute for this process (Meta limits are per team; contributor models allow 150).
MODEL_RPM=120
# on (default): students see their skill's move ranking. off: students decide from the
# board, per-move facts and lessons alone. Use the same setting for every study arm.
MODEL_STUDENT_HELPER=on
